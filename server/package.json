{
  "name": "mmo-server",
  "version": "3.0.0",
  "description": "MMO Server (MixAI Companion) — serves local music and video files to the MixAI web app",
  "main": "dist/main.js",
  "author": {
    "name": "mwrty",
    "email": "vladulescu.catalin@gmail.com"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/dragoscv/mmo",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragoscv/mmo.git"
  },
  "scripts": {
    "dev": "pnpm ui:build && tsc-watch --onFirstSuccess \"electronmon .\"",
    "dev:once": "pnpm ui:build && tsc && electron .",
    "dev:inspect": "pnpm ui:build && tsc-watch --onFirstSuccess \"electronmon --inspect=0.0.0.0:9229 --remote-debugging-port=9222 .\"",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "build": "pnpm ui:build && tsc",
    "build:headless": "tsc",
    "start": "electron .",
    "start:headless": "node dist/headless.js",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "pnpm rebuild audify",
    "dist": "pnpm build && node scripts/prepare-rbexport.mjs && electron-builder --win --x64",
    "dist:win": "pnpm build && node scripts/prepare-rbexport.mjs && electron-builder --win --x64",
    "dist:mac": "pnpm build && node scripts/prepare-rbexport.mjs && electron-builder --mac",
    "dist:linux": "pnpm build && node scripts/prepare-rbexport.mjs && electron-builder --linux",
    "fetch:virtual-audio": "node scripts/fetch-virtual-audio.mjs",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "build:rbexport": "cargo build --release --manifest-path native/rbexport/Cargo.toml",
    "validate:rbexport": "cargo build --release --manifest-path native/rbexport/Cargo.toml && node native/rbexport/tools/validate-usb.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:lint": "redocly lint openapi.yaml",
    "openapi:check": "node scripts/openapi-check.mjs",
    "openapi:gen": "node scripts/openapi-kotlin.mjs && pnpm --dir ../packages/sdk gen:openapi",
    "openapi:preview": "redocly preview-docs openapi.yaml"
  },
  "build": {
    "appId": "ro.mixai.companion",
    "productName": "MixAI Companion",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "afterPack": "scripts/mac-adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "dragoscv",
        "repo": "mmo",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "ui/dist/**/*",
      "assets/**/*",
      "!src/**",
      "!ui/src/**",
      "!ui/public/**",
      "!ui/index.html",
      "!ui/*.ts",
      "!ui/tsconfig.json",
      "!**/*.ts",
      "!**/*.map",
      "!tsconfig.json",
      "!vitest.config.ts"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "README.md"
        ]
      },
      {
        "from": "assets/fpcalc",
        "to": "fpcalc",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/virtual-audio",
        "to": "virtual-audio",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      },
      {
        "from": "assets/cloudflared",
        "to": "cloudflared",
        "filter": [
          "**/*",
          "!.gitkeep",
          "!.gitignore",
          "!README.md"
        ]
      },
      {
        "from": "assets/bin",
        "to": "bin",
        "filter": [
          "rbexport",
          "rbexport.exe"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/audify/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**",
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "type": "distribution"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio",
      "synopsis": "MixAI Companion — MMO Server, local media server for the MixAI web app",
      "description": "Electron companion daemon (MMO Server) that serves your local music library, recordings, and downloads to the MixAI web app. Bundles the BlackHole / pactl virtual-audio adapter so you can route per-deck audio without third-party drivers.",
      "maintainer": "mwrty <vladulescu.catalin@gmail.com>",
      "vendor": "mwrty",
      "desktop": {
        "entry": {
          "Name": "MixAI Companion — MMO Server",
          "Comment": "Local media server for the MixAI web app",
          "Categories": "AudioVideo;Audio;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ],
      "recommends": [
        "pulseaudio-utils | pipewire-pulse"
      ]
    },
    "rpm": {
      "depends": [
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret",
        "alsa-lib"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MixAI Companion",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bindings": "^1.5.0",
    "bonjour-service": "^1.4.4",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "discord-rpc": "^4.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "file-uri-to-path": "^1.0.0",
    "music-metadata": "^11.15.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "audify": "^1.10.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@redocly/cli": "^2.53.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "electronmon": {
    "patterns": [
      "dist/**/*",
      "ui/dist/**/*",
      "preload.js",
      "!**/node_modules/**",
      "!**/release/**",
      "!**/*.m4s",
      "!**/*.m3u8",
      "!**/init.mp4",
      "!**/seg_*.m4s",
      "!**/mmo-hls-*/**"
    ],
    "logLevel": "quiet"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.0",
      "node-abi": "^4.35.0"
    },
    "onlyBuiltDependencies": [
      "audify",
      "better-sqlite3",
      "electron",
      "electron-winstaller"
    ]
  }
}
