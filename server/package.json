{
  "name": "mmo-companion",
  "version": "0.9.9",
  "description": "MMO Companion Server — serves local music files to MMO web app",
  "main": "dist/main.js",
  "author": {
    "name": "mwrty",
    "email": "vladulescu.catalin@gmail.com"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "dev:inspect": "tsc && electron --inspect=0.0.0.0:9229 --remote-debugging-port=9222 dist/main.js",
    "build": "tsc",
    "start": "electron dist/main.js",
    "dist": "tsc && electron-builder --win --x64",
    "dist:win": "tsc && electron-builder --win --x64",
    "dist:mac": "tsc && electron-builder --mac",
    "dist:linux": "tsc && electron-builder --linux"
  },
  "build": {
    "appId": "com.mwrty.mmo-companion",
    "productName": "MMO Companion",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "afterPack": "scripts/mac-adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "dragoscv",
        "repo": "mmo"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "!src/**",
      "!**/*.ts",
      "!tsconfig.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "README.md"
        ]
      },
      {
        "from": "assets/fpcalc",
        "to": "fpcalc",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/audify/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "type": "distribution"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MMO Companion",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "audify": "^1.10.1",
    "better-sqlite3": "^11.7.0",
    "bindings": "^1.5.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.4",
    "ee-first": "^1.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "encodeurl": "^2.0.0",
    "escape-html": "^1.0.3",
    "express": "^4.21.0",
    "file-uri-to-path": "^1.0.0",
    "finalhandler": "^1.3.1",
    "ms": "^2.1.3",
    "music-metadata": "^10.6.4",
    "on-finished": "^2.4.1",
    "parseurl": "^1.3.3",
    "statuses": "^2.0.1",
    "unpipe": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.14",
    "electron": "^34.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "audify",
      "better-sqlite3",
      "electron",
      "electron-winstaller"
    ]
  }
}