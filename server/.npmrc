# Force a flat (hoisted) node_modules layout.
#
# electron-builder packages the production dependency tree by walking
# node_modules from the project root. With pnpm's default symlinked
# layout (node_modules/.pnpm/<pkg>@<ver>/node_modules/<pkg>), some
# transitive dependencies of native/CommonJS modules — notably
# express → finalhandler → on-finished → ee-first — are not always
# resolved correctly inside the packed app.asar, leading to runtime
# `Cannot find module 'ee-first'` errors and a non-functional audio
# engine.
#
# Using node-linker=hoisted makes pnpm install a classic flat
# node_modules tree, which electron-builder packs reliably.
node-linker=hoisted
shamefully-hoist=true
hoist-pattern[]=*
public-hoist-pattern[]=*
