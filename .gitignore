.pnpm-cache/
.next/
/app/data/downloads/
node_modules/
/server/node_modules/

# Build outputs
/server/dist/
/server/release/
/app/.next/
*.tsbuildinfo

# Downloaded CI artifacts (local-only)
/artifacts/

# Stale build / typecheck logs
/tsc-out.txt
/server/dist-win.log
/app/tsc-errors.log
/app/tsc-report.txt

# One-off lint/typecheck/test dumps & ad-hoc analysis scripts (never commit)
eslint-out.json
eslint-out.txt
eslint-snapshot.json
eslint-compact.txt
/build-output.txt
/app/lc.json
/app/_scan.js
/app/analyze.js
/app/parse.js

# SQLite WAL / SHM sidecar files (data/music-organizer.db itself is dev-only too)
*.db-shm
*.db-wal

# Python bytecode
__pycache__/
*.pyc

# Stale backups
*.legacy.bak

# Bundled virtual audio drivers — fetched at build time from upstream
# release URLs with pinned SHA-256s; do not commit binaries.
/server/assets/virtual-audio/macos/*.pkg
/server/assets/virtual-audio/windows/*.inf
/server/assets/virtual-audio/windows/*.sys
/server/assets/virtual-audio/windows/*.cat
/server/assets/virtual-audio/windows/*.zip
/server/assets/virtual-audio/windows/*.exe

.vercel

*.log

artifacts/

# Dev tunnel sentinel (written by scripts/dev-tunnel.ps1)
.vscode/.dev-tunnel-url
.vercel

# Temp env dumps (e.g. `vercel env pull .env.prod.tmp`) — never commit secrets
.env*.tmp
.env.prod.tmp

# Azure resource names (local-only, contains globally unique random suffixes)
.azure-names.txt
.venvs/
.test/
_test_acestep/
_test_full_pipeline/
_test_stems/
.azure-sp.json

# Azure / cloud credential blobs (local-only, contain secrets)
.azure-openai.json
.azure-speech.json

# Embedded upstream repos vendored locally (not tracked as submodules)
external/
