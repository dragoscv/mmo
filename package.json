{
    "name": "mmo-monorepo",
    "private": true,
    "version": "0.0.0",
    "description": "MMO root \u2014 hosts husky hooks + workspace declaration. Each sub-package keeps its own pnpm-lock.yaml so existing CI (web-app, companion) and Vercel continue to work unchanged.",
    "scripts": {
        "prepare": "node -e \"try{require('child_process').execSync(process.platform==='win32'?'husky.cmd':'husky',{stdio:'inherit'})}catch(e){}\"",
        "check:extension-version": "node apps/extension/scripts/check-version.mjs",
        "changeset": "changeset",
        "version": "changeset version",
        "release:changelog": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.10",
        "husky": "^9.1.7"
    },
    "packageManager": "pnpm@10.0.0"
}
