{
    "name": "mmo-monorepo",
    "private": true,
    "version": "0.0.0",
    "description": "MixAI \u2014 Multi Media Organizer (self-hosted MMO Server + MixAI apps). Root hosts husky hooks + workspace declaration. Each sub-package keeps its own pnpm-lock.yaml so existing CI (web-app, companion) and Vercel continue to work unchanged.",
    "scripts": {
        "dev:setup": "node ./scripts/prepare-husky.cjs",
        "check:extension-version": "node apps/extension/scripts/check-version.mjs",
        "tokens:build": "pnpm -C packages/design-tokens build",
        "hex:check": "node scripts/hex-gate.mjs",
        "i18n:check": "pnpm -C apps/web i18n:check && pnpm -C apps/extension i18n:check",
        "bundle:check": "pnpm -C apps/web bundle:check",
        "typecheck": "pnpm -r --if-present --no-bail run typecheck",
        "lint": "pnpm -r --if-present --no-bail run lint",
        "test": "pnpm -r --if-present --no-bail run test",
        "build": "pnpm -r --if-present --no-bail run build",
        "typecheck:web": "pnpm -C apps/web typecheck",
        "test:web": "pnpm -C apps/web test",
        "test:ui": "pnpm -C packages/ui test && pnpm -C packages/design-tokens test",
        "changeset": "changeset",
        "version": "changeset version",
        "release:changelog": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.10",
        "husky": "^9.1.7"
    },
    "packageManager": "pnpm@10.0.0"
}
