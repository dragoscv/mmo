{
  "version": 1,
  "repo": "mmo",
  "trackers": [
    {
      "id": "mixai-design",
      "file": "docs/mixai-design-tracker.csv",
      "format": "csv",
      "columns": {
        "id": "id",
        "title": "title",
        "status": "status",
        "group": "surface",
        "notes": "decision_or_notes"
      },
      "idPattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,40}$",
      "status": {
        "map": {
          "done": "done",
          "blocked": "blocked",
          "doing": "in-progress",
          "todo": "todo"
        }
      },
      "index": {
        "kind": "plan",
        "order": 1
      }
    }
  ]
}
