# Keep one lockfile per sub-package. Prevents pnpm from collapsing
# app/pnpm-lock.yaml + server/pnpm-lock.yaml + apps/*/pnpm-lock.yaml
# into a single root lockfile, which would break the existing Vercel
# deployment (root=app/) and the companion-release workflow.
shared-workspace-lockfile=false

# Auto-install peer deps where unambiguous; matches what app/ already does.
auto-install-peers=true
