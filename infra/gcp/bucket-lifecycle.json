{
  "lifecycle": {
    "rule": [
      {
        "condition": {
          "age": 90
        },
        "action": {
          "type": "SetStorageClass",
          "storageClass": "ARCHIVE"
        }
      },
      {
        "condition": {
          "age": 365
        },
        "action": {
          "type": "Delete"
        }
      }
    ]
  }
}
