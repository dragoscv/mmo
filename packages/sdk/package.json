{
  "name": "@mmo/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Thin TypeScript client for MMO's REST + SSE API. Drop-in replacement for in-process @mmo/ai when calling MMO from external projects. ESM-only, zero React deps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mmo-server": "./src/mmo-server.ts",
    "./generated/mmo-server": "./src/generated/mmo-server.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:openapi": "pnpm --dir ../../server exec openapi-typescript openapi.yaml -o ../packages/sdk/src/generated/mmo-server.d.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
