{
  "name": "@mmo/ai",
  "version": "0.0.1",
  "private": true,
  "description": "MMO shared AI core. Providers, models, agents, tools, prompts, RAG. Consumed by app/, server/, apps/native, apps/extension and exposed externally via @mmo/ai-mcp and @mmo/sdk.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/codai": "./src/providers/codai.ts",
    "./providers/copilot": "./src/providers/copilot.ts",
    "./models": "./src/models/index.ts",
    "./agent": "./src/agent/index.ts",
    "./tools": "./src/tools/index.ts",
    "./prompts": "./src/prompts/index.ts",
    "./rag": "./src/rag/index.ts",
    "./settings": "./src/settings/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.51",
    "@ai-sdk/provider": "^4.0.17"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
