{
  "name": "@mmo/design-tokens",
  "version": "1.0.0",
  "private": true,
  "description": "MixAI design tokens — single source of truth (OKLCH palette, theme dimensions, spacing, radius, motion, breakpoints). Generates CSS (Tailwind v4 @theme), JSON, Kotlin and plain-CSS bundles for every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./dist/tokens.css",
    "./css/plain": "./dist/tokens.plain.css",
    "./json": "./dist/tokens.json",
    "./prehydrate": "./dist/prehydrate.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
