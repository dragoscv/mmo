{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MixAI Live",
    "version": "0.1.0",
    "identifier": "ro.mixai.live",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:14430",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MixAI Live",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 680,
                "resizable": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob:",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline' http://localhost:14430",
                "style-src": "'self' 'unsafe-inline' http://localhost:14430",
                "img-src": "'self' data: blob: http://localhost:14430",
                "font-src": "'self' data: http://localhost:14430",
                "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* http://localhost:14430 ws://localhost:14430",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "dangerousDisableAssetCspModification": ["style-src"],
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "category": "Music",
        "shortDescription": "MixAI Live — realtime vocal processor for live performance",
        "longDescription": "MixAI Live is a low-latency vocal effects processor for singers: pitch correction, harmonizer, dynamics, EQ, reverb and delay, setlists with per-song presets, and phone/watch remotes over the local network.",
        "copyright": "© mwrty",
        "publisher": "mwrty",
        "homepage": "https://live.mixai.ro",
        "externalBin": ["binaries/mixai-live-engine"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "windows": {
            "nsis": { "installMode": "currentUser", "languages": ["English"] }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "hardenedRuntime": true
        },
        "linux": {
            "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"] }
        }
    },
    "plugins": {}
}
