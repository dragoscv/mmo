{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MMO",
    "version": "0.1.0",
    "identifier": "ro.muzicai.app",
    "build": {
        "frontendDist": "../web",
        "beforeDevCommand": "",
        "beforeBuildCommand": ""
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MMO",
                "width": 1400,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "backgroundColor": "#0a0a0a"
            }
        ],
        "security": {
            "csp": null,
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "category": "Music",
        "shortDescription": "MMO — Music Media Organizer",
        "longDescription": "Native shell for the MMO web app at https://muzicai.ro. Bundles the live experience with the platform's native window chrome and ships with the existing PWA service worker for offline support.",
        "copyright": "© mwrty",
        "publisher": "mwrty",
        "homepage": "https://muzicai.ro",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": {
                "language": "en-US"
            },
            "nsis": {
                "installMode": "currentUser",
                "languages": ["English"]
            }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "hardenedRuntime": true,
            "entitlements": null,
            "exceptionDomain": "muzicai.ro"
        },
        "linux": {
            "deb": {
                "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
            },
            "rpm": {},
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    },
    "plugins": {}
}
