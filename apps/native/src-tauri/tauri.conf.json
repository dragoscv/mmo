{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MixAI Studio",
    "version": "1.1.0",
    "identifier": "ro.mixai.studio",
    "build": {
        "frontendDist": "../web",
        "beforeDevCommand": "",
        "beforeBuildCommand": ""
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "MixAI Studio",
                "width": 1400,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "backgroundColor": "#0a0a0a"
            }
        ],
        "security": {
            "csp": null,
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "category": "Music",
        "shortDescription": "MixAI Studio — organise, analyse and prepare your music library",
        "longDescription": "MixAI Studio is the desktop window for app.mixai.ro: organise, tag, analyse and prepare your music library on your own MixAI Server, with native sign-in and window chrome.",
        "copyright": "© 2026 MixAI",
        "publisher": "MixAI",
        "homepage": "https://app.mixai.ro",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": {
                "language": "en-US"
            },
            "nsis": {
                "installMode": "currentUser",
                "languages": ["English"]
            }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "hardenedRuntime": true,
            "entitlements": null,
            "exceptionDomain": "app.mixai.ro"
        },
        "linux": {
            "deb": {
                "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
            },
            "rpm": {},
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    },
    "plugins": {}
}
