# Tauri build output
src-tauri/target/
src-tauri/gen/

# Capacitor: android/ scaffold IS tracked (AndroidManifest.xml carries the
# Leanback/TV additions — see ANDROID_TV.md). Only generated output is ignored.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/capacitor.build.gradle
android/capacitor.settings.gradle
# iOS project is still generated on demand (`pnpm cap:add:ios`, macOS only)
ios/
dist/

# Generated icons (recreated by `pnpm tauri icon`)
src-tauri/icons/

# Node
node_modules/
*.log
.env
.env.local
.env.*.local
