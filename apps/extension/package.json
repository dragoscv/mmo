{
	"name": "mmo-extension",
	"version": "3.0.1",
	"private": true,
	"description": "MixAI browser extension (Chrome/Firefox MV3) — one-click 'Download to MixAI' button on streaming sites; opens /download in the MixAI web app. Vendored deps live in vendor/, design tokens in tokens.css (generated).",
	"scripts": {
		"i18n:check": "node ../../scripts/i18n-parity-ext.mjs",
		"vendor:polyfill": "node -e \"const fs=require(\\\"fs\\\");const path=require(\\\"path\\\");const src=path.resolve(__dirname,\\\"node_modules/webextension-polyfill/dist/browser-polyfill.min.js\\\");const dest=path.resolve(__dirname,\\\"vendor/browser-polyfill.min.js\\\");fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(src,dest);console.log(\\\"Copied\\\",dest);\""
	},
	"devDependencies": {
		"webextension-polyfill": "^0.12.0"
	}
}
