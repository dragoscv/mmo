{
  "name": "mmo-extension",
  "version": "1.3.0",
  "private": true,
  "description": "MMO browser extension - vendored deps live in vendor/",
  "scripts": {
    "vendor:polyfill": "node -e \"const fs=require(\\\"fs\\\");const path=require(\\\"path\\\");const src=path.resolve(__dirname,\\\"node_modules/webextension-polyfill/dist/browser-polyfill.min.js\\\");const dest=path.resolve(__dirname,\\\"vendor/browser-polyfill.min.js\\\");fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(src,dest);console.log(\\\"Copied\\\",dest);\""
  },
  "devDependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
