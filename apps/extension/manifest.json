{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "3.0.1",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "mixai-downloader@mixai.ro",
            "strict_min_version": "115.0"
        }
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://music.youtube.com/*",
        "*://*.soundcloud.com/*",
        "*://*.spotify.com/*",
        "*://*.bandcamp.com/*",
        "*://*.mixcloud.com/*",
        "*://*.vimeo.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://*.deezer.com/*",
        "*://mixai.ro/*",
        "*://*.mixai.ro/*",
        "http://localhost:13789/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://music.youtube.com/*",
                "*://*.soundcloud.com/*",
                "*://*.spotify.com/*",
                "*://*.bandcamp.com/*",
                "*://*.mixcloud.com/*",
                "*://*.vimeo.com/*",
                "*://*.tiktok.com/*",
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.instagram.com/*",
                "*://*.facebook.com/*",
                "*://*.twitch.tv/*",
                "*://*.dailymotion.com/*",
                "*://*.deezer.com/*"
            ],
            "js": [
                "vendor/browser-polyfill.min.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://mixai.ro/*",
                "*://*.mixai.ro/*"
            ],
            "js": [
                "beacon.js"
            ],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.svg",
            "32": "icons/icon32.svg",
            "48": "icons/icon48.svg",
            "128": "icons/icon128.svg"
        }
    },
    "icons": {
        "16": "icons/icon16.svg",
        "32": "icons/icon32.svg",
        "48": "icons/icon48.svg",
        "128": "icons/icon128.svg"
    }
}
