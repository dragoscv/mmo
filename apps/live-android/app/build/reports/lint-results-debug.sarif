                                    "endLine": 39,
                                    "snippet": {
                                        "text": "        android:enableOnBackInvokedCallback=\"true\"\n        android:usesCleartextTraffic=\"true\"\n        android:allowBackup=\"false\"\n        android:supportsRtl=\"true\">\n\n"
                                    }
