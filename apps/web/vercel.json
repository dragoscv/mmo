{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "buildCommand": "pnpm build",
    "installCommand": "pnpm install --frozen-lockfile || pnpm install --frozen-lockfile --force",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cron/training-reconcile",
            "schedule": "*/2 * * * *"
        }
    ]
}