{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "buildCommand": "pnpm build",
    "installCommand": "pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store-fresh || (rm -rf /vercel/path0/.pnpm-store /vercel/path0/node_modules/.pnpm node_modules/.pnpm && pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store-fresh)",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cron/training-reconcile",
            "schedule": "*/2 * * * *"
        }
    ]
}