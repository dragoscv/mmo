{
  "name": "music-organizer",
  "version": "2.0.0",
  "description": "MixAI — AI music suite for DJs and producers (mixai.ro)",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 13789",
    "build:css": "tailwindcss -i src/app/globals.src.css -o public/globals.css --minify",
    "sync:learn": "node scripts/sync-learn-content.mjs",
    "sync:jassub": "node scripts/sync-jassub.mjs",
    "predev": "pnpm run build:css && pnpm run sync:learn && pnpm run sync:jassub",
    "prebuild": "pnpm run build:css && pnpm run sync:learn && pnpm run sync:jassub",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start -p 13789",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/lint-baseline.mjs snapshot",
    "lint:check": "node scripts/lint-baseline.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "lhci": "lhci autorun --config=./lighthouserc.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/apply-sql-migrations.mjs",
    "db:migrate:prod": "node scripts/apply-sql-migrations.mjs --prod",
    "db:status": "node scripts/apply-sql-migrations.mjs --status",
    "db:status:prod": "node scripts/apply-sql-migrations.mjs --prod --status",
    "db:mark-applied": "node scripts/apply-sql-migrations.mjs --mark-applied",
    "db:mark-applied:prod": "node scripts/apply-sql-migrations.mjs --prod --mark-applied",
    "db:studio": "drizzle-kit studio"
  },
