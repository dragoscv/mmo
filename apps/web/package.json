{
  "name": "music-organizer",
  "version": "0.6.3",
  "description": "MuzicAI — AI music suite for DJs and producers (muzicai.ro)",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 13789",
    "build:css": "tailwindcss -i src/app/globals.src.css -o public/globals.css --minify",
    "sync:learn": "node scripts/sync-learn-content.mjs",
    "sync:jassub": "node scripts/sync-jassub.mjs",
    "predev": "pnpm run build:css && pnpm run sync:learn && pnpm run sync:jassub",
    "prebuild": "pnpm run build:css && pnpm run sync:learn && pnpm run sync:jassub",
    "build": "next build --webpack",
    "build:analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start -p 13789",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/lint-baseline.mjs snapshot",
    "lint:check": "node scripts/lint-baseline.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "lhci": "lhci autorun --config=./lighthouserc.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/apply-sql-migrations.mjs",
    "db:migrate:prod": "node scripts/apply-sql-migrations.mjs --prod",
    "db:status": "node scripts/apply-sql-migrations.mjs --status",
    "db:status:prod": "node scripts/apply-sql-migrations.mjs --prod --status",
    "db:mark-applied": "node scripts/apply-sql-migrations.mjs --mark-applied",
    "db:mark-applied:prod": "node scripts/apply-sql-migrations.mjs --prod --mark-applied",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/google": "^2",
    "@ai-sdk/groq": "^2",
    "@ai-sdk/mistral": "^2",
    "@ai-sdk/openai": "^2",
    "@ai-sdk/openai-compatible": "^1.0.39",
    "@ai-sdk/provider": "^2.0.3",
    "@ai-sdk/react": "^2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@breezystack/lamejs": "^1.2.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/storage": "^7.19.0",
    "@octokit/rest": "^21.0.2",
    "ai": "^5.0.188",
    "cheerio": "^1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "^5.2.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.5.12",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^9.15.1",
    "hls.js": "^1.6.16",
    "jose": "^5",
    "lucide-react": "^1.8.0",
    "mobile-drag-drop": "3.0.0-rc.0",
    "music-metadata": "^11.12.3",
    "next": "^16.2.3",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.0.2",
    "next-themes": "^0.4.6",
    "node-id3": "^0.2.9",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^9.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "systeminformation": "^5.31.5",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.49",
    "@tailwindcss/cli": "4.0.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.9"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": "22.x"
  }
}
