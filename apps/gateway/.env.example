# MuzicAI Gateway — environment

# Shared Postgres (same DB as apps/web). Cloud SQL public IP + SSL in prod.
DATABASE_URL=

# Must equal apps/web AUTH_SECRET — device-token HMAC/AES keys derive from it.
AUTH_SECRET=

# Cloudflare Tunnel provisioning (same values as apps/web). Optional; when
# unset the companion falls back to LAN/queue transport.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ZONE_ID=
CLOUDFLARE_TUNNEL_BASE_HOSTNAME=muzicai.ro

# HTTP port (Cloud Run injects PORT=8080).
PORT=8080

# Comma-separated CORS allow-list for /api/* (browser is not a client today,
# but the announce route is POSTed by the companion which sends no Origin).
CORS_ALLOW_ORIGINS=https://muzicai.ro

# Optional pool size per instance.
DB_POOL_MAX=5
