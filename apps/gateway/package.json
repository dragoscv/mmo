{
  "name": "@mmo/gateway",
  "version": "0.2.0",
  "private": true,
  "description": "MixAI companion control-plane gateway (Hono on Cloud Run). Owns the device heartbeat (HTTP announce + WebSocket) and command channel, off the Vercel hot path.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.17",
    "postgres": "^3.4.9",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
