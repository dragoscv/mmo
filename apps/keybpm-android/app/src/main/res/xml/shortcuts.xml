<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts + Google Assistant App Actions (OPEN_APP_FEATURE "listen" / "identify song" / "what key"). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ro.mixai.keybpm"
            android:targetClass="ro.mixai.keybpm.MainActivity">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="listen"
        android:enabled="true"
        android:icon="@drawable/ic_stat_listen"
        android:shortcutShortLabel="@string/shortcut_listen"
        android:shortcutLongLabel="@string/shortcut_listen">
        <intent
            android:action="ro.mixai.keybpm.LISTEN"
            android:targetPackage="ro.mixai.keybpm"
            android:targetClass="ro.mixai.keybpm.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="listen" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="identify"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_identify"
        android:shortcutLongLabel="@string/shortcut_identify">
        <intent
            android:action="ro.mixai.keybpm.IDENTIFY"
            android:targetPackage="ro.mixai.keybpm"
            android:targetClass="ro.mixai.keybpm.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="identify song" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="what_key"
        android:enabled="true"
        android:icon="@drawable/ic_stat_listen"
        android:shortcutShortLabel="@string/shortcut_what_key"
        android:shortcutLongLabel="@string/shortcut_what_key">
        <intent
            android:action="ro.mixai.keybpm.WHAT_KEY"
            android:targetPackage="ro.mixai.keybpm"
            android:targetClass="ro.mixai.keybpm.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="what key" />
        </capability-binding>
    </shortcut>
</shortcuts>
