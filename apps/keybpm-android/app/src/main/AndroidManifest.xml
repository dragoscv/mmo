<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Merged from :core (MixAI Music player) and implied by the ShazamKit AAR (no targetSdk): Key & BPM plays no
        media and needs no phone/storage access, so these must not reach the Play listing or the FGS declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

        <!-- Live key/BPM from the microphone. Audio is analysed on the device and never recorded or uploaded; Song ID
            (user-triggered or tracklist mode) sends only a ShazamKit fingerprint to Shazam. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Background listening (WP18-18): microphone foreground service + its ongoing notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Update: the listening notification as a promoted ongoing chip (key in the status bar). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Stage mode "Do not disturb" (user grants access in Settings; optional). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Optional MMO Server connection: LAN discovery (mDNS) + HTTP to the user's own server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- MIDI clock out (WP18-08) is optional. -->
    <uses-feature android:name="android.software.midi" android:required="false" />

    <!-- "Play in MixAI Music" from the compatible tracks list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mixai-music" />
        </intent>
    </queries>

    <application
        android:name=".KeyBpmApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.KeyBpm.Starting"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" / "Share to" an audio file → file mode. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Static shortcuts + Assistant App Actions (Listen / Identify song / What key is this?). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Set log CSV export through the share sheet (cache/exports only). -->
        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- One-tap "Identify song" home-screen widget (opens the app, which starts listening + Song ID). -->
        <receiver
            android:name=".IdentifyWidget"
            android:exported="false"
            android:label="@string/widget_identify">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_identify_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick Settings tile: live key + BPM, tap to start / stop listening. -->
        <service
            android:name=".ListenTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_listen"
            android:label="@string/qs_listen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name="ro.mixai.tv.player.MusicService" tools:node="remove" />
    </application>
</manifest>
