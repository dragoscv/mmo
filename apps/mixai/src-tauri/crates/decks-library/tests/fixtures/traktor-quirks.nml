<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<NML VERSION="20"><HEAD COMPANY="www.native-instruments.com" PROGRAM="Traktor Pro 4"></HEAD>
<COLLECTION ENTRIES="5">
<ENTRY TITLE="Startup Disk" ARTIST="Ana">
<LOCATION DIR="/:Users/:dj/:Music/:" FILE="a.mp3" VOLUME="Studio HD" VOLUMEID="abc"></LOCATION>
<INFO FILESIZE="7812" PLAYTIME="200"></INFO>
<TEMPO BPM="122.000000" BPM_QUALITY="100.000000"></TEMPO>
<CUE_V2 NAME="AutoGrid" DISPL_ORDER="0" TYPE="4" START="100.000000" LEN="0.000000" REPEATS="-1" HOTCUE="0"><GRID BPM="122.000000"></GRID></CUE_V2>
<CUE_V2 NAME="Beat Marker" DISPL_ORDER="0" TYPE="4" START="100.000000" LEN="0.000000" REPEATS="-1" HOTCUE="-1"><GRID BPM="122.000000"></GRID></CUE_V2>
<CUE_V2 NAME="Zero loop" DISPL_ORDER="0" TYPE="5" START="30000.000000" LEN="0.000000" REPEATS="-1" HOTCUE="1"></CUE_V2>
<CUE_V2 NAME="Before start" DISPL_ORDER="0" TYPE="0" START="-50.000000" LEN="0.000000" REPEATS="-1" HOTCUE="2"></CUE_V2>
<CUE_V2 NAME="Odd type" DISPL_ORDER="0" TYPE="7" START="45000.000000" LEN="0.000000" REPEATS="-1" HOTCUE="-1"></CUE_V2>
<CUE_V2 NAME="Odd type" DISPL_ORDER="0" TYPE="7" START="45000.000000" LEN="0.000000" REPEATS="-1" HOTCUE="-1"></CUE_V2>
</ENTRY>
<ENTRY TITLE="External" ARTIST="Bo">
<LOCATION DIR="/:DJ Music/:House" FILE="b.mp3" VOLUME="USB Stick" VOLUMEID="def"></LOCATION>
</ENTRY>
<ENTRY TITLE="Windows" ARTIST="Cy">
<LOCATION DIR="/:Muzică/:Șină/:" FILE="c &amp; d.flac" VOLUME="E:" VOLUMEID="E:"></LOCATION>
</ENTRY>
<ENTRY TITLE="Windows dup" ARTIST="Cy">
<LOCATION DIR="/:Muzică/:Șină/:" FILE="c &amp; d.flac" VOLUME="E:" VOLUMEID="E:"></LOCATION>
</ENTRY>
<ENTRY TITLE="Stream">
<LOCATION DIR="" FILE="" VOLUME="" VOLUMEID=""></LOCATION>
</ENTRY>
</COLLECTION>
<PLAYLISTS>
<NODE TYPE="FOLDER" NAME="$ROOT"><SUBNODES COUNT="1">
<NODE TYPE="PLAYLIST" NAME="Mixed"><PLAYLIST ENTRIES="2" TYPE="LIST" UUID="u">
<ENTRY><PRIMARYKEY TYPE="TRACK" KEY="USB Stick/:DJ Music/:House/:b.mp3"></PRIMARYKEY></ENTRY>
<ENTRY><PRIMARYKEY TYPE="TRACK" KEY="E:/:Muzică/:Șină/:c &amp; d.flac"></PRIMARYKEY></ENTRY>
</PLAYLIST></NODE>
</SUBNODES></NODE>
</PLAYLISTS>
</NML>
