{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MixAI Decks",
    "version": "1.7.0",
    "identifier": "ro.mixai.dj",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:14420",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MixAI Decks",
                "width": 1500,
                "height": 940,
                "minWidth": 1024,
                "minHeight": 820,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "transparent": false,
                "backgroundColor": "#070711"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob: https://mixai.ro",
                "font-src": "'self' data:",
                "connect-src": "ipc: http://ipc.localhost https://mixai.ro",
                "media-src": "'self' blob: data:",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline' http://localhost:14420",
                "style-src": "'self' 'unsafe-inline' http://localhost:14420",
                "img-src": "'self' data: blob: https://mixai.ro http://localhost:14420",
                "font-src": "'self' data: http://localhost:14420",
                "connect-src": "ipc: http://ipc.localhost https://mixai.ro http://localhost:14420 ws://localhost:14420",
                "media-src": "'self' blob: data:",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "dangerousDisableAssetCspModification": ["style-src"],
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "category": "Music",
        "shortDescription": "MixAI Decks — native DJ software",
        "longDescription": "MixAI Decks is the native DJ application of the mixai.ro suite: low-latency Rust audio engine, themeable animated UI, broad controller support, and mixai.ro library + AI integration.",
        "copyright": "© 2026 MixAI",
        "publisher": "MixAI",
        "homepage": "https://decks.mixai.ro",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": { "language": "en-US" },
            "nsis": { "installMode": "currentUser", "languages": ["English"] }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "hardenedRuntime": true,
            "entitlements": null
        },
        "linux": {
            "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"] },
            "rpm": {},
            "appimage": { "bundleMediaFramework": true }
        }
    },
    "plugins": {}
}
