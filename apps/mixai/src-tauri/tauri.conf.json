{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MIXAI",
    "version": "0.1.0",
    "identifier": "ro.muzicai.mixai",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:14420",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MIXAI",
                "width": 1500,
                "height": 940,
                "minWidth": 1180,
                "minHeight": 820,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "backgroundColor": "#070711"
            }
        ],
        "security": {
            "csp": null,
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "category": "Music",
        "shortDescription": "MIXAI — native DJ software",
        "longDescription": "MIXAI is the native DJ application of the muzicai.ro suite: low-latency Rust audio engine, themeable animated UI, broad controller support, and muzicai.ro library + AI integration.",
        "copyright": "© mwrty",
        "publisher": "mwrty",
        "homepage": "https://muzicai.ro",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": { "language": "en-US" },
            "nsis": { "installMode": "currentUser", "languages": ["English"] }
        },
        "macOS": {
            "minimumSystemVersion": "10.15",
            "hardenedRuntime": true,
            "entitlements": null
        },
        "linux": {
            "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"] },
            "rpm": {},
            "appimage": { "bundleMediaFramework": true }
        }
    },
    "plugins": {}
}
