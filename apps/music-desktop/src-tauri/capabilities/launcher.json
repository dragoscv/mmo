{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "launcher",
    "description": "Local pages (launcher web/index.html in the main window, web/mini.html in the mini player): sign-in, pending deep link, mini-player state + commands, window close.",
    "windows": ["main", "mini"],
    "permissions": [
        "core:default",
        "core:window:allow-close",
        "core:window:allow-start-dragging",
        "allow-desktop-auth",
        "allow-desktop-auth-cancel",
        "allow-get-web-app-url",
        "allow-web-reachable",
        "allow-take-pending-path",
        "allow-mini-state",
        "allow-mini-command"
    ]
}
