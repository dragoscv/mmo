{
  "sourceLanguage": "en",
  "strings": {
    "account.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your MixAI account removes your sign-in, linked servers, push registrations and synced data. This cannot be undone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea contului MixAI elimină autentificarea, serverele asociate, înregistrările push și datele sincronizate. Acțiunea este ireversibilă."
          }
        }
      }
    },
    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge contul"
          }
        }
      }
    },
    "account.delete.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was deleted."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul tău a fost șters."
          }
        }
      }
    },
