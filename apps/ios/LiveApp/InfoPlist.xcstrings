{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live uses the camera only to scan the pairing QR code shown by MixAI Live on your computer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live folosește camera doar ca să scaneze codul QR de asociere afișat de MixAI Live pe computer."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live finds and controls the MixAI Live engine on your computer over this network."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "MixAI Live găsește și controlează motorul MixAI Live de pe computer prin această rețea."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Local engine mode MixAI Live processes your voice on this device. Audio is never recorded or sent."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În modul Motor local MixAI Live îți procesează vocea pe acest dispozitiv. Sunetul nu este înregistrat și nu este trimis."
          }
        }
      }
    }
  },
  "version": "1.0"
}
