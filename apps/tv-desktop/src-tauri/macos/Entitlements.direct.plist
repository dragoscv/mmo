<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MixAI TV — Developer ID direct download (WP17-26). Hardened runtime, not sandboxed; WKWebView needs JIT.
  No camera, microphone, file or hardware entitlements: MixAI TV only plays from the user's server.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
