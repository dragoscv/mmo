{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "pnpm dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(?!\\s*(✓|○|▲|⚠|●|✗))(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting...",
          "endsPattern": "Ready in"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev (Inspect)",
      "type": "shell",
      "command": "pnpm dev:inspect",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on macOS VM",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-mac.ps1",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on macOS VM (Watch)",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-mac.ps1 -Watch",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on Linux VM",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-linux.ps1",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on Linux VM (Watch)",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-linux.ps1 -Watch",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on Windows VM",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-win.ps1",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Dev on Windows VM (Watch)",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./server/scripts/dev-on-win.ps1 -Watch",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Companion: Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Companion: Build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "build",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Companion: Dist (Windows)",
      "type": "shell",
      "command": "pnpm dist:win",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "DB Studio",
      "type": "shell",
      "command": "pnpm db:studio",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "DB: Status (local)",
      "type": "shell",
      "command": "pnpm db:status",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "DB: Status (production)",
      "type": "shell",
      "command": "pnpm db:status:prod",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "DB: Migrate (local)",
      "type": "shell",
      "command": "pnpm db:migrate",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "DB: Migrate (production)",
      "type": "shell",
      "command": "pnpm db:migrate:prod",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "DB: Mark Pending Migrations Applied (production)",
      "detail": "Records all pending migrations as applied on prod WITHOUT running them. Use once when adopting the runner on a DB that already has the schema.",
      "type": "shell",
      "command": "pnpm db:mark-applied:prod -- --yes",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "DB: Generate Migration (from schema diff)",
      "type": "shell",
      "command": "pnpm db:generate",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "pnpm exec tsc --noEmit",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clean .next Cache",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue; Write-Host '.next cache removed.'",
      "options": {
        "cwd": "${workspaceFolder}/app",
        "shell": { "executable": "pwsh", "args": ["-NoProfile", "-Command"] }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "statusbar.list.hiddenTasks": [
    "Companion: Dev (Inspect)",
    "Companion: Dev on macOS VM",
    "Companion: Dev on macOS VM (Watch)",
    "Companion: Dev on Linux VM",
    "Companion: Dev on Linux VM (Watch)",
    "Companion: Dev on Windows VM",
    "Companion: Dev on Windows VM (Watch)",
    "Companion: Install Dependencies",
    "Companion: Build",
    "Companion: Dist (Windows)",
    "Install Dependencies",
    "Build",
    "DB Studio",
    "Type Check"
  ]
}
