# MMO Web App — Environment variables
# Copy this file to `.env.local` and fill in the secrets.
# Never commit `.env.local` to git.

# ============================================================
# Auth.js v5 (next-auth)
# ============================================================

# Required: secret used to sign session JWT/cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js v5 auto-detects host; set explicitly for non-localhost dev:
# AUTH_URL=http://localhost:3000

# ----- Google OAuth (currently the only configured provider) -----
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ============================================================
# Database (Drizzle / Postgres)
# ============================================================
# Cloud SQL Postgres provisioned via infra/terraform.
# Cloud:  postgres://postgres:PASSWORD@34.79.95.212:5432/mmo?sslmode=require
# Local:  postgres://postgres:dev@localhost:5432/mmo  (see app/docker-compose.yml)
DATABASE_URL=

# ============================================================
# Cloud Storage (user-uploaded files: recordings, artwork)
# ============================================================
GCS_BUCKET=mmo-user-files-prod
# Base64-encoded service account JSON. Locally you can leave this empty
# and use Application Default Credentials instead:
#   gcloud auth application-default login
GCP_SERVICE_ACCOUNT_KEY=

# ============================================================
# Stripe (payments / subscriptions)
# ============================================================
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for Pro tier (create products in Stripe dashboard first):
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# ============================================================
# MMO Companion download endpoint
# ============================================================
# /api/companion/download fetches the latest companion release from
# GitHub. These default to the public repo and don't need overrides
# unless you fork.
COMPANION_REPO_OWNER=dragoscv
COMPANION_REPO_NAME=mmo

# Optional: GitHub personal access token (scope: public_repo) to avoid
# the 60 req/h unauthenticated rate limit on /api/companion/download.
# Only useful if many users hit your instance simultaneously.
GITHUB_TOKEN=

# ============================================================
# WebRTC / Remote (TURN credentials)
# ============================================================
# Outputs from `terraform apply` in infra/terraform/. Required only if
# you use the /remote module with users behind strict NAT.
TURN_HOST=
TURN_SHARED_SECRET=
TURN_REALM=mmo.local

# ============================================================
# Spotify metadata search (optional)
# ============================================================
# Used by /api/download/search to enrich results with Spotify metadata.
# Without these the Spotify provider is silently skipped.
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================================
# Companion URL override (advanced)
# ============================================================
# Default loopback URL the browser probes for the desktop companion.
# Only override if you changed PORT in server/src/server.ts.
# NEXT_PUBLIC_COMPANION_URL=http://127.0.0.1:17899

# ============================================================
# Web Push notifications (VAPID) — optional
# ============================================================
# Required if you want the server to push notifications to installed
# PWA clients (e.g. "scan finished", "playlist updated from another
# device"). Generate a keypair with:
#   npx web-push generate-vapid-keys --json
# The public key is exposed to the browser (NEXT_PUBLIC_); the private
# key MUST stay server-only. The subject can be any contact URL/email
# the push provider can reach you at if your sender misbehaves.
# Without these the push subscription endpoint returns 503 and the SW
# push handler still runs (rendering anything an authenticated proxy
# delivers), so the app degrades cleanly.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@muzicai.ro

# ============================================================
# Sentry error tracking (optional)
# ============================================================
# All Sentry wiring is opt-in: if SENTRY_DSN is unset, the lazy shim in
# `lib/sentry.ts` short-circuits and `@sentry/nextjs` is never resolved
# at build time. Self-hosted deployments that want zero outbound
# telemetry can leave every variable below blank.
#
# To enable on the free tier:
#   1. Create a project at https://sentry.io/signup/ (free: 5k errors/mo).
#   2. `pnpm add @sentry/nextjs` in /app — kept as an optional peer dep.
#   3. Set SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser) below.
#   4. Re-deploy. `instrumentation.ts` initialises on cold-start.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: override the inferred environment tag (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=
# Optional: release identifier for source-map uploads / regression tracking.
# Conventionally `mmo@<git-sha>` or the package.json version.
SENTRY_RELEASE=
# Set to "1" to forward IP / cookies / session data with events. Off by
# default to keep PII out of error reports.
SENTRY_SEND_PII=
# Set to "1" to enable the in-browser user-feedback widget.
NEXT_PUBLIC_SENTRY_FEEDBACK=

# ============================================================
# Auth allowlist (optional)
# ============================================================
# Comma-separated emails permitted to sign in. Leave blank to allow any
# successful OAuth/passkey sign-in. Useful for staging / pre-launch.
AUTH_ALLOWED_EMAILS=

# ============================================================
# Build & analysis tooling
# ============================================================
# Set ANALYZE=true to emit the @next/bundle-analyzer report on `pnpm build`.
ANALYZE=

# ============================================================
# Azure AI (optional — used by analysis features)
# ============================================================
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=
AZURE_AI_API_VERSION=

# ============================================================
# Companion / device pairing
# ============================================================
# Server-side secret used to derive companion device tokens. Generate with
# `openssl rand -hex 32`. MUST stay secret. Rotating invalidates all paired
# companions and forces re-pairing.
MMO_SECRET_KEY=
# Set to "1" to allow companions to register URLs on RFC1918 / link-local
# ranges (10.x, 192.168.x, 169.254.x). Off in production; on for LAN dev.
MMO_ALLOW_PRIVATE_DEVICE_URLS=
# Comma-separated absolute directories the /api/audio/[id] route is willing
# to stream from local disk (path-containment allowlist). Leave blank in
# hosted/multi-tenant deployments — clients fall back to the companion HTTP
# proxy. Example (Windows): MMO_LOCAL_AUDIO_ROOTS=H:\Music,E:\DJ
MMO_LOCAL_AUDIO_ROOTS=
# Optional override for the python executable invoked by the analysis
# subprocess. Defaults to `python` (PATH lookup).
MMO_PYTHON=

# ============================================================
# Download Hub — extension store URLs (public)
# ============================================================
# Permanent storefront URLs surfaced in the in-app download modal. Leave
# any of them blank to hide the corresponding store card.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
NEXT_PUBLIC_FIREFOX_EXTENSION_URL=
NEXT_PUBLIC_EDGE_EXTENSION_URL=

# ============================================================
# Download Hub — native app store URLs (public)
# ============================================================
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_TESTFLIGHT_URL=

# ============================================================
# Universal / app links
# ============================================================
# Apple Developer Team ID baked into /.well-known/apple-app-site-association
# (iOS Universal Links). Format: 10-char alphanumeric (e.g. AB12CD34EF).
NEXT_PUBLIC_APPLE_TEAM_ID=
# Comma-separated SHA-256 cert fingerprints (uppercase, colon-separated)
# for the Android app, baked into /.well-known/assetlinks.json. Get with:
#   keytool -list -v -keystore <keystore> -alias <alias>
NEXT_PUBLIC_ANDROID_CERT_FINGERPRINTS=