/* eslint-disable */
/**
 * pitch-shifter-processor.js
 *
 * Real-time pitch shifter for vocal autocorrect, with optional LPC
 * formant preservation. Mono in / mono out.
 *
 * AudioParams:
 *   - `pitchRatio`      (a-rate, 0.25..4) — playback ratio; 1.0 = unchanged.
 *   - `mix`             (a-rate, 0..1)    — dry/wet mix.
 *   - `bypass`          (k-rate, 0/1)     — 1 outputs the dry signal.
 *   - `formantPreserve` (k-rate, 0/1)     — 1 enables LPC formant warping.
 *
 * ── Why 2 heads, 50% overlap, sin² windows ──────────────────────────
 *
 * Earlier iteration used 4 heads at 75% overlap. With Hann² windows
 * Σ envelope = 2 (clean COLA), BUT at ratio ≠ 1 the four heads read
 * four different chunks of input voice. For quasi-periodic voice the
 * interference between those chunks modulates the *content* amplitude
 * at the grain rate (≈ 187 Hz for GRAIN=1024) — perceived as a low
 * pulse / "robot" pitch sitting on top of the corrected note.
 *
 * 2 heads at 50% overlap with sin² (= Hann²) windows give an exact
 * COLA of 1 (sin²(πt) + cos²(πt) = 1). Only ONE crossfade transition
 * per GRAIN_SIZE/2 output samples → audible content modulation drops
 * to the grain rate alone (≈ 23 Hz for GRAIN=2048), sub-bass and
 * largely inaudible.
 *
 * ── Why no deadzone / dry-fade ──────────────────────────────────────
 *
 * At ratio = 1 the granular machinery already reconstructs the dry
 * signal exactly (heads read writeIdx − GRAIN + phase). A separate
 * dry-pass crossfade with hysteresis around ratio=1 was *cancelling
 * out* the correction whenever the singer's pitch wobbled across the
 * deadzone band, and producing slow amplitude modulation as the
 * crossfade target oscillated. Removed.
 *
 * ── Output-time phase ───────────────────────────────────────────────
 *
 * Each head has its own phase counter [0..GRAIN_SIZE) that advances
 * by exactly +1 per output sample (independent of `ratio`). The
 * envelope sin²(π·phase/GRAIN_SIZE) baleiates 0→0 every grain. On
 * phase wrap (== 0) the head re-anchors its read position to
 * `writeIdx − lag` so it reads only past data, never the future.
 * Re-anchor is silent because env is exactly 0 at that sample.
 *
 * ── Formant preservation (LPC) ──────────────────────────────────────
 *
 *   1. Maintain a sliding analysis buffer of the dry input.
 *   2. Every LPC_UPDATE_INTERVAL samples, run Levinson-Durbin on the
 *      autocorrelation to compute LPC_ORDER prediction coefficients.
 *   3. Per-sample inverse-filter dry → residual (formants flattened).
 *   4. Pitch-shift the residual through the granular machinery.
 *   5. Per-sample synthesis-filter shifted-residual with the SAME
 *      coefficients → output keeps the original formants.
 *
 * Coefficient updates use linear interpolation over UPDATE_INTERVAL
 * samples. Updates with unstable reflection coefficients (|k| ≥ 1)
 * are skipped — prior coeffs keep running.
 *
 * Latency: GRAIN_SIZE samples (~43 ms @ 48 kHz). Acceptable for
 * real-time vocal autocorrect monitoring.
 */

const GRAIN_SIZE = 1024;          // output samples per grain (~21 ms @ 48k).
                                  // Perceived shifter latency = GRAIN/2
                                  // (peak of sin² envelope) ≈ 10.6 ms.
                                  // WSOLA below makes 1024 sound clean
                                  // even on quasi-periodic voice; 2048
                                  // was over-cautious historically.
const NUM_HEADS = 2;              // 50 % overlap
const HEAD_STAGGER = GRAIN_SIZE / NUM_HEADS; // 512
const BUF_SIZE = GRAIN_SIZE * 8;  // generous: max read distance ≪ BUF_SIZE

// One-pole smoother on pitchRatio (τ ≈ 3 ms @ 48 kHz). Kills zipper noise.
const RATIO_SMOOTH_TC = 0.9925;

// ── WSOLA (Waveform-Similarity OverLap-Add) ─────────────────────────
//
// At every re-anchor, instead of jumping the read head to the nominal
// `writeIdx − lag` position blindly, we search a small window around
// that position for the offset that best aligns the new grain with
// the waveform the OTHER head is currently producing. This eliminates
// the phase-discontinuity at grain joins that produces the "robotic
// buzz" on quasi-periodic signals like voice (comb filtering on
// highs, phase scrambling on lows).
//
// SEARCH_RANGE ≈ half a period at ~120 Hz (the lower end of male
// vocal pitch) — enough to find a phase-aligned anchor within one
// pitch period for any sung note ≥ ~120 Hz.
//
// CORR_LEN = 128 samples (~2.7 ms) is long enough to capture phase
// alignment but short enough that a single CPU loop per re-anchor
// is cheap (≈ 100 k mul-adds per re-anchor every 1024 samples →
// ≈ 5 % CPU at 48 kHz on a typical core).
const WSOLA_SEARCH = 200;
const WSOLA_CORR_LEN = 128;

// LPC formant preservation
const LPC_ORDER = 12;             // typical for speech ~ fs/1000 + 4
const LPC_WINDOW = 512;           // ~10 ms analysis window
const LPC_UPDATE_INTERVAL = 256;  // recompute every ~5 ms
const LPC_HIST_SIZE = LPC_ORDER + 1;

class PitchShifterProcessor extends AudioWorkletProcessor {
    static get parameterDescriptors() {
        return [
            { name: "pitchRatio",      defaultValue: 1, minValue: 0.25, maxValue: 4, automationRate: "a-rate" },
            { name: "mix",             defaultValue: 1, minValue: 0,    maxValue: 1, automationRate: "a-rate" },
            { name: "bypass",          defaultValue: 0, minValue: 0,    maxValue: 1, automationRate: "k-rate" },
            { name: "formantPreserve", defaultValue: 0, minValue: 0,    maxValue: 1, automationRate: "k-rate" },
        ];
    }

    constructor() {
        super();
        // ── Delay-line buffer ────────────────────────────────────────
        this.buffer = new Float32Array(BUF_SIZE);
        this.writeIdx = 0;

        // ── Read heads (output-time phase + buffer read position) ────
        // Stagger initial phases so that from sample 0 the two sin²
        // windows already sum to a constant 1.
        this.headPhase = new Float32Array(NUM_HEADS);
        this.headRead  = new Float32Array(NUM_HEADS);
        for (let k = 0; k < NUM_HEADS; k++) {
            this.headPhase[k] = (HEAD_STAGGER * k) % GRAIN_SIZE;
            // Read-pos starts behind writer by GRAIN_SIZE so the very
            // first grain reads silence (clean fade-in, no startup pop).
            this.headRead[k] = (BUF_SIZE - GRAIN_SIZE + HEAD_STAGGER * k) % BUF_SIZE;
        }

        // ── Smoothing state ──────────────────────────────────────────
        this.ratioSmoothed = 1;
        // `lag` (= GRAIN_SIZE * max(1, ratio)) is what we use when
        // re-anchoring read heads. Re-anchor happens at phase=0, so a
        // new lag value is only sampled at the moment a head wraps. But
        // if `ratio` makes a big jump WHILE a head is mid-grain, that
        // head's anchor is stale for the rest of the grain and reads
        // discontinuous content (= pop). We mirror the smoother on a
        // "lag drive" value so even at the smoother's 3 ms TC the lag
        // used for the next anchor is in lock-step with the audible
        // ratio at that instant.
        this.lagSmoothed = GRAIN_SIZE;

        // ── LPC state ────────────────────────────────────────────────
        this.lpcInputBuf = new Float32Array(LPC_WINDOW);
        this.lpcInputIdx = 0;
        this.invHist  = new Float32Array(LPC_HIST_SIZE); // x[n-k] for inverse filter
        this.invHistIdx = 0;
        this.synthHist = new Float32Array(LPC_HIST_SIZE); // y[n-k] for synth filter
        this.synthHistIdx = 0;
        // Live + target coefficient sets (a[0]=1; coeffs are a[1..p]).
        this.lpcA       = new Float32Array(LPC_HIST_SIZE); this.lpcA[0]       = 1;
        this.lpcAtarget = new Float32Array(LPC_HIST_SIZE); this.lpcAtarget[0] = 1;
        this.lpcAdelta  = new Float32Array(LPC_HIST_SIZE);
        this.lpcInterpRemaining = 0;
        this.samplesSinceLpcUpdate = LPC_UPDATE_INTERVAL; // force update on first chunk
        this.lpcReady = false;

        // Scratch arrays for LPC computation
        this._lpcAutocorr = new Float32Array(LPC_HIST_SIZE);
        this._lpcA_new    = new Float32Array(LPC_HIST_SIZE);
        this._lpcA_temp   = new Float32Array(LPC_HIST_SIZE);
        this._lpcWindow   = new Float32Array(LPC_WINDOW);
        this._lpcWinFunc  = new Float32Array(LPC_WINDOW);
        for (let n = 0; n < LPC_WINDOW; n++) {
            // Hamming window
            this._lpcWinFunc[n] = 0.54 - 0.46 * Math.cos(2 * Math.PI * n / (LPC_WINDOW - 1));
        }

        // WSOLA scratch (reference window for cross-correlation search).
        this._wsolaRef = new Float32Array(WSOLA_CORR_LEN);
    }

    /** Linear-interpolated read with circular wrap. */
    _read(idx) {
        let i = idx;
        if (i < 0) i += BUF_SIZE;
        else if (i >= BUF_SIZE) i -= BUF_SIZE;
        const i0 = i | 0;
        const i1 = (i0 + 1) % BUF_SIZE;
        const frac = i - i0;
        return this.buffer[i0] * (1 - frac) + this.buffer[i1] * frac;
    }

    /**
     * WSOLA anchor refinement. Given the nominal anchor `nominalRead`
     * and a reference signal (= what the OTHER head will produce over
     * the next CORR_LEN samples), find the offset within ±SEARCH_RANGE
     * that maximizes normalized cross-correlation between the buffer
     * starting at `nominal+offset` and the reference. Returns the
     * refined read position.
     *
     * `otherRead` is the other head's current read position; that head
     * advances by `ratio` per output sample, so its next CORR_LEN
     * samples are buffer[otherRead + j*ratio] for j=0..CORR_LEN-1.
     */
    _wsolaAnchor(nominalRead, otherRead, ratio) {
        // Build reference (CORR_LEN samples from the other head).
        const ref = this._wsolaRef;
        let refE = 0;
        for (let j = 0; j < WSOLA_CORR_LEN; j++) {
            const v = this._read(otherRead + j * ratio);
            ref[j] = v;
            refE += v * v;
        }
        if (refE < 1e-9) return nominalRead; // silence → no point searching

        // Normalised cross-correlation search.
        let bestScore = -Infinity;
        let bestOffset = 0;
        for (let off = -WSOLA_SEARCH; off <= WSOLA_SEARCH; off++) {
            let dot = 0, candE = 0;
            const start = nominalRead + off;
            for (let j = 0; j < WSOLA_CORR_LEN; j++) {
                const v = this._read(start + j * ratio);
                dot += v * ref[j];
                candE += v * v;
            }
            if (candE < 1e-9) continue;
            // NCC: cos(angle) — robust to amplitude differences.
            const score = dot / Math.sqrt(candE * refE);
            if (score > bestScore) {
                bestScore = score;
                bestOffset = off;
            }
        }
        return nominalRead + bestOffset;
    }

    /**
     * Levinson-Durbin LPC. Reads the rolling input buffer (windowed),
     * computes autocorrelation, derives prediction coefficients, and
     * stages them into lpcAtarget for crossfade.
     * @returns true on success, false on instability/silence.
     */
    _computeLpc() {
        const win = this._lpcWindow;
        const start = this.lpcInputIdx; // oldest sample is at lpcInputIdx
        for (let n = 0; n < LPC_WINDOW; n++) {
            const idx = (start + n) % LPC_WINDOW;
            win[n] = this.lpcInputBuf[idx] * this._lpcWinFunc[n];
        }

        // Autocorrelation r[0..p]
        const r = this._lpcAutocorr;
        for (let k = 0; k <= LPC_ORDER; k++) {
            let acc = 0;
            for (let n = 0; n < LPC_WINDOW - k; n++) {
                acc += win[n] * win[n + k];
            }
            r[k] = acc;
        }
        if (r[0] < 1e-10) return false; // silence

        // Levinson-Durbin
        const a = this._lpcA_new;
        const tmp = this._lpcA_temp;
        a.fill(0); a[0] = 1;
        let e = r[0];
        for (let i = 1; i <= LPC_ORDER; i++) {
            let acc = r[i];
            for (let j = 1; j < i; j++) acc += a[j] * r[i - j];
            const k = -acc / e;
            if (Math.abs(k) >= 0.999) return false;
            tmp.set(a);
            tmp[i] = k;
            for (let j = 1; j < i; j++) tmp[j] = a[j] + k * a[i - j];
            a.set(tmp);
            e *= 1 - k * k;
            if (e < 1e-12) break;
        }

        // Stage interpolation toward the new target.
        for (let k = 0; k <= LPC_ORDER; k++) {
            this.lpcAtarget[k] = a[k];
            this.lpcAdelta[k] = (a[k] - this.lpcA[k]) / LPC_UPDATE_INTERVAL;
        }
        this.lpcInterpRemaining = LPC_UPDATE_INTERVAL;
        this.lpcReady = true;
        return true;
    }

    process(inputs, outputs, parameters) {
        const input = inputs[0];
        const output = outputs[0];
        if (!output || output.length === 0) return true;
        const outCh = output[0];
        const inCh = input && input[0] ? input[0] : null;

        const pitchParam = parameters.pitchRatio;
        const mixParam   = parameters.mix;
        const bypass     = parameters.bypass[0] >= 0.5;
        const formantOn  = parameters.formantPreserve[0] >= 0.5;

        const blockLen = outCh.length;

        // Recompute LPC at top of block if due.
        if (formantOn && this.samplesSinceLpcUpdate >= LPC_UPDATE_INTERVAL) {
            this._computeLpc();
            this.samplesSinceLpcUpdate = 0;
        }

        for (let i = 0; i < blockLen; i++) {
            const dry = inCh ? inCh[i] : 0;

            // Feed LPC analysis ring with dry input (always; cheap).
            this.lpcInputBuf[this.lpcInputIdx] = dry;
            this.lpcInputIdx = (this.lpcInputIdx + 1) % LPC_WINDOW;

            if (bypass) {
                // Keep delay buffer in sync so re-engage is smooth.
                this.buffer[this.writeIdx] = dry;
                this.writeIdx = (this.writeIdx + 1) % BUF_SIZE;
                outCh[i] = dry;
                continue;
            }

            // ── 1. Build the signal that goes into the granular shifter.
            //    Without formant preserve: dry directly.
            //    With formant preserve: residual = x + Σ a[k]*x[n-k].
            let toShift = dry;
            if (formantOn && this.lpcReady) {
                if (this.lpcInterpRemaining > 0) {
                    for (let k = 1; k <= LPC_ORDER; k++) {
                        this.lpcA[k] += this.lpcAdelta[k];
                    }
                    this.lpcInterpRemaining--;
                }
                let r = dry;
                for (let k = 1; k <= LPC_ORDER; k++) {
                    const idx = (this.invHistIdx - k + LPC_HIST_SIZE) % LPC_HIST_SIZE;
                    r += this.lpcA[k] * this.invHist[idx];
                }
                toShift = r;
                this.invHist[this.invHistIdx] = dry;
                this.invHistIdx = (this.invHistIdx + 1) % LPC_HIST_SIZE;
            }

            // Write to-shift signal into the delay-line buffer.
            this.buffer[this.writeIdx] = toShift;
            this.writeIdx = (this.writeIdx + 1) % BUF_SIZE;

            // ── 2. Smooth ratio (kills zipper noise from stepped automation).
            const ratioRaw = pitchParam.length > 1 ? pitchParam[i] : pitchParam[0];
            this.ratioSmoothed =
                this.ratioSmoothed * RATIO_SMOOTH_TC + ratioRaw * (1 - RATIO_SMOOTH_TC);
            const ratio = this.ratioSmoothed;
            const mix = mixParam.length > 1 ? mixParam[i] : mixParam[0];

            // Lag must keep readPos behind writeIdx for the whole grain.
            // Over GRAIN_SIZE phase ticks readPos advances by GRAIN_SIZE*ratio,
            // so lag must be ≥ GRAIN_SIZE*ratio. For ratio<1 we still want
            // GRAIN_SIZE so we read past content. Smoothing the lag with
            // the same TC as the ratio prevents a freshly-anchored head
            // from being starved (or overrunning) when ratio jumps.
            const lagTarget = GRAIN_SIZE * (ratio > 1 ? ratio : 1);
            this.lagSmoothed =
                this.lagSmoothed * RATIO_SMOOTH_TC + lagTarget * (1 - RATIO_SMOOTH_TC);
            const lag = this.lagSmoothed;

            // ── 3. Sum 2 windowed read heads. sin² windows + 50 %
            //       overlap → Σ envelopes ≡ 1 (perfect COLA).
            let wet = 0;
            const w = this.writeIdx;
            for (let k = 0; k < NUM_HEADS; k++) {
                const phase = this.headPhase[k];
                const t = phase / GRAIN_SIZE;
                const s = Math.sin(Math.PI * t);
                const env = s * s; // sin²

                if (env > 0) {
                    let rp = this.headRead[k];
                    if (rp < 0) rp += BUF_SIZE;
                    else if (rp >= BUF_SIZE) rp -= BUF_SIZE;
                    wet += this._read(rp) * env;
                }

                // Advance.
                let newPhase = phase + 1;
                let newRead = this.headRead[k] + ratio;
                if (newPhase >= GRAIN_SIZE) {
                    // Re-anchor at phase=0: env is exactly 0 → no click.
                    // Use WSOLA to refine the anchor so the new grain
                    // is phase-aligned with whatever the OTHER head is
                    // currently producing. This is what eliminates the
                    // residual robotic buzz on quasi-periodic voice.
                    newPhase = 0;
                    const nominal = w - lag;
                    const otherK = (k + 1) % NUM_HEADS;
                    const otherRead = this.headRead[otherK];
                    let anchored = this._wsolaAnchor(nominal, otherRead, ratio);
                    if (anchored < 0) anchored += BUF_SIZE;
                    else if (anchored >= BUF_SIZE) anchored -= BUF_SIZE;
                    newRead = anchored;
                }
                this.headPhase[k] = newPhase;
                this.headRead[k]  = newRead;
            }
            // No normalization needed: sin²(πt) + cos²(πt) = 1.

            // ── 4. Optional LPC re-synthesis (re-applies original formants).
            let shifted = wet;
            if (formantOn && this.lpcReady) {
                let y = wet;
                for (let k = 1; k <= LPC_ORDER; k++) {
                    const idx = (this.synthHistIdx - k + LPC_HIST_SIZE) % LPC_HIST_SIZE;
                    y -= this.lpcA[k] * this.synthHist[idx];
                }
                // Soft cubic clip: linear up to ±3, smooth fold beyond.
                // Hard clip introduced harmonics audible as crackle when
                // the recursive synth filter rang on transients; the
                // cubic fold keeps the slope continuous so transients
                // saturate gracefully instead of snapping.
                const ay = y < 0 ? -y : y;
                if (ay > 3) {
                    const sgn = y < 0 ? -1 : 1;
                    // Map [3, ∞) → [3, 4) via a soft fold.
                    y = sgn * (3 + (1 - 1 / (1 + (ay - 3) * 0.5)));
                }
                this.synthHist[this.synthHistIdx] = y;
                this.synthHistIdx = (this.synthHistIdx + 1) % LPC_HIST_SIZE;
                shifted = y;
            }

            // ── 5. Mix dry/wet. No deadzone trickery — at ratio=1 the
            //       granular machinery already reconstructs `dry` exactly
            //       (heads read writeIdx − GRAIN + phase, COLA = 1), so a
            //       separate dry-pass would only fight the wet path.
            outCh[i] = dry * (1 - mix) + shifted * mix;
        }

        if (formantOn) this.samplesSinceLpcUpdate += blockLen;

        return true;
    }
}

registerProcessor("pitch-shifter", PitchShifterProcessor);
